# Evolution API configuration. Pinned against evolution-api v2.3.7.
#
# Copy to infra/local/evolution.env, fill in the secrets, then symlink it into the
# vendored checkout (Evolution reads .env from its own working directory):
#
#   cp infra/local/evolution.env.example infra/local/evolution.env
#   ln -sf ../../infra/local/evolution.env vendor/evolution-api/.env
#
# Only the variables we deliberately set are listed. Everything omitted keeps
# Evolution's own default, which is off for every integration we do not use.

# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
SERVER_NAME=evolution
SERVER_TYPE=http
SERVER_PORT=8080
# Locally this is the loopback address. On the VPS it is the gateway
# administration hostname, reached only through Caddy on 443 and restricted by
# IP allowlist — Evolution is never exposed directly.
SERVER_URL=http://localhost:8080

# The single credential for every gateway call. Our services read it from their
# own environment; it is never written into source.
AUTHENTICATION_API_KEY=

# We do not send instance telemetry to a third party.
TELEMETRY_ENABLED=false

LANGUAGE=en
LOG_LEVEL=ERROR,WARN,INFO,LOG,WEBHOOKS
LOG_COLOR=true
LOG_BAILEYS=error

# Instances are deleted deliberately through the lifecycle API, never on a timer.
DEL_INSTANCE=false

# ─────────────────────────────────────────────────────────────────────────────
# Database — the Supabase project for this system
# ─────────────────────────────────────────────────────────────────────────────
# psql_bouncer is the provider that configures Prisma for transaction-mode
# pooling: it points the runtime client at the pooler and keeps a separate direct
# connection for migrations. Using the plain `postgresql` provider against a
# transaction-mode pooler is the misconfiguration that produces intermittent
# "prepared statement ... already exists" errors under load.
#
#   DATABASE_BOUNCER_CONNECTION_URI → Prisma `url`       → pooler, port 6543
#   DATABASE_CONNECTION_URI         → Prisma `directUrl` → session pooler, port 5432
#
# Evolution owns the `evolution` schema inside the project's single `postgres`
# database; the bridge has its own schema alongside.
#
# directUrl is the session pooler rather than db.<ref>.supabase.co because the
# direct host is IPv6-only and unreachable from networks without v6 transit.
# Session mode gives migrations the prepared statements they need regardless.
#
# connection_limit is 10, not 1. connection_limit=1 is Prisma's guidance for
# serverless, where each invocation is a separate short-lived process. Evolution
# is a long-running server, so 1 serialises every query through a single
# connection: measured, ~5 concurrent requests was the ceiling and beyond it
# Prisma returned "Timed out fetching a new connection from the connection pool"
# rather than any pooler-side error.
DATABASE_PROVIDER=psql_bouncer
DATABASE_BOUNCER_CONNECTION_URI=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?schema=evolution&pgbouncer=true&connection_limit=10
DATABASE_CONNECTION_URI=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=evolution
DATABASE_CONNECTION_CLIENT_NAME=evolution

# Session and instance state persists, so a restart does not drop connections.
DATABASE_SAVE_DATA_INSTANCE=true

# Everything below stays off. Chatwoot is the system of record for conversations
# and we do not keep a second copy of customer messages. These flags are off
# safely because we do not use Evolution's built-in Chatwoot integration — see
# docs/01-evolution.md. Our bridge keeps its own id-mapping table, which stores
# identifiers only, no message content.
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false
DATABASE_SAVE_IS_ON_WHATSAPP=false
DATABASE_DELETE_MESSAGE=false

# ─────────────────────────────────────────────────────────────────────────────
# Cache — no Redis
# ─────────────────────────────────────────────────────────────────────────────
# Local cache is sufficient at this volume. Redis can be added later if there is
# a reason; nothing here depends on it.
CACHE_REDIS_ENABLED=false
CACHE_LOCAL_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# Webhooks
# ─────────────────────────────────────────────────────────────────────────────
# Off globally: each instance gets its own webhook configuration so we can route
# per number and take one line out without touching the others.
WEBHOOK_GLOBAL_ENABLED=false
# How long Evolution waits for our bridge to accept a webhook before it assumes
# the delivery failed and sends the message again. Raised from the 30s default
# because inbound media is downloaded and pushed to Chatwoot while Evolution is
# waiting, and a large document does not fit in thirty seconds.
#
# Overrunning it was never fatal — the bridge keeps working after Evolution stops
# listening, the message still lands, and the retry is dropped as a duplicate
# against the claim in bridge.message_map. What this buys is the absence of those
# pointless retries, and headroom for the bridge's own timeouts to be generous.
# Keep it above the bridge's download + upload timeouts in evolution.ts and
# chatwoot.ts, which together are what actually decide when a file is given up on.
WEBHOOK_REQUEST_TIMEOUT_MS=120000

# ─────────────────────────────────────────────────────────────────────────────
# Integrations we do not use
# ─────────────────────────────────────────────────────────────────────────────
# Our bridge owns the Chatwoot relationship. Evolution's built-in integration
# would require message retention we have deliberately turned off.
CHATWOOT_ENABLED=false
RABBITMQ_ENABLED=false
SQS_ENABLED=false
WEBSOCKET_ENABLED=false
S3_ENABLED=false
