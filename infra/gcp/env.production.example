# Production environment for the Compute Engine VM. Lives at /opt/wa/.env.
#
# Copy this to the VM once and fill it in there. It is never committed and never
# leaves the box:
#
#   infra/gcp/ssh.sh
#   sudo nano /opt/wa/.env
#   sudo chmod 600 /opt/wa/.env
#
# This is the same shape as the repository-root .env used in development. The
# values differ; the names do not.

NODE_ENV=production

# ─────────────────────────────────────────────────────────────────────────────
# Public hostnames
# ─────────────────────────────────────────────────────────────────────────────
# The three hostnames Caddy serves. Defaults below are sslip.io names pointing at
# this VM's reserved address, 203.0.113.10 — sslip.io resolves any
# <anything>.<ip>.sslip.io to that IP, so Let's Encrypt issues a real certificate
# with no domain bought and no DNS configured.
#
# This is deliberate rather than lazy: Chatwoot Cloud refuses to deliver webhooks
# to a self-signed certificate, so without publicly trusted TLS the inbound half of
# the bridge cannot be exercised on this box at all.
#
# When the real domain arrives, change these three values and reload Caddy. Nothing
# else moves.
WA_GATEWAY_HOST=gateway.203.0.113.10.sslip.io
WA_BRIDGE_HOST=bridge.203.0.113.10.sslip.io
WA_PANEL_HOST=panel.203.0.113.10.sslip.io

# Who may reach the gateway administration hostname. Space-separated addresses or
# CIDR ranges. These controls can log a live WhatsApp number out, which takes a
# sales line off the air until someone notices, so this list stays short.
#
# Left unset it defaults to 127.0.0.1 — nobody — which locks you out rather than
# letting everyone in. That is the intended failure direction.
#
# Find your current address with:  curl -s https://ifconfig.me
# Most home and office connections change address periodically; if administration
# starts returning 403, that is usually why.
WA_ADMIN_ALLOWLIST=

# ─────────────────────────────────────────────────────────────────────────────
# Supabase project for this system
# ─────────────────────────────────────────────────────────────────────────────
# The bridge uses node-postgres, not Prisma, so no ?schema= parameter here — it
# would be ignored. Its queries are schema-qualified (bridge.message_map) instead.
BRIDGE_DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Evolution API
# ─────────────────────────────────────────────────────────────────────────────
# EVOLUTION_BASE_URL is not set here — Compose overrides it to http://evolution:8080,
# the service name on the internal Docker network.
#
# Must be the same value as AUTHENTICATION_API_KEY in evolution.env. They are two
# ends of one secret, and a mismatch shows up as every bridge call returning 401.
EVOLUTION_API_KEY=

# Required. Evolution sends this back as the x-bridge-secret header on every
# webhook, and the bridge rejects a post that arrives without it — which is what
# stops a stranger who finds the address from inventing customer messages. The
# bridge registers the header with Evolution itself; setting it here is all that
# is needed. The bridge refuses to start without it, on purpose.
# Generate a long random one:  openssl rand -hex 32
EVOLUTION_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Chatwoot Cloud — system of record for conversations
# ─────────────────────────────────────────────────────────────────────────────
# SEED ONLY, since 2026-09-02. The live values are in the bridge.chatwoot_settings
# table, edited on the Operator Console's Settings screen. On its first boot against an
# empty table the bridge copies these in; after that they are inert — an edit made
# in the panel survives every deploy, and a stale value left here changes nothing.
# A fresh environment can leave them empty and set everything up in the panel.
CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
# Required on inbound Chatwoot webhooks. Chatwoot's inbox webhooks cannot send
# custom headers, so this rides in the query string — which makes it the only thing
# standing between a leaked URL and the ability to send WhatsApp messages as you.
# Generate a long random one:  openssl rand -hex 32
CHATWOOT_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Encryption at rest for stored secrets
# ─────────────────────────────────────────────────────────────────────────────
# bridge.chatwoot_settings holds the Chatwoot API token and webhook secret. They
# are encrypted in the table with this key, which is never stored beside them —
# so a database dump on its own is worth nothing.
#
# The Operator Console must carry the SAME value. It reads and writes that row too, and
# a different key means it cannot read what the bridge wrote. Changing the key
# makes the stored secrets unreadable and they have to be entered again in the
# panel, so treat it as permanent.
# Generate:  openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Bridge
# ─────────────────────────────────────────────────────────────────────────────
BRIDGE_PORT=3001
# BRIDGE_PUBLIC_URL is set by Compose, not here. Line routing is not an
# environment variable at all — it lives in the bridge.lines table.
# Used only when a number arrives without a country code. WhatsApp JIDs always
# carry one, so this is a fallback that should rarely fire.
DEFAULT_COUNTRY_CODE=

# ─────────────────────────────────────────────────────────────────────────────
# Monitoring and alerting
# ─────────────────────────────────────────────────────────────────────────────
# How long a line may stay disconnected before the alert email goes out.
LINE_DISCONNECT_ALERT_SECONDS=180

# Alert email goes out through Resend (https://resend.com), not SMTP. The bridge
# sends the automatic disconnect and reconnect alerts; the Operator Console on Vercel
# sends the test email from Settings → Notifications, so BOTH need these set.
#
# Not required to start. Without the key the bridge runs exactly as normal and
# logs a warning at boot — and then tells nobody the day a line drops, which is
# why the warning is there.
RESEND_API_KEY=
# The From line. Resend only accepts an address on a domain verified in its
# dashboard. Left as the default, sending still works but Resend delivers only to
# the Resend account's own email address — a working test, not working alerts.
ALERT_FROM_EMAIL=onboarding@resend.dev
