{
  "name": "@multiline/bridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bridge between the Evolution gateway and Chatwoot",
  "scripts": {
    "dev": "tsx watch --import ../../scripts/load-env.mjs src/index.ts",
    "start": "node --import ../../scripts/load-env.mjs dist/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
