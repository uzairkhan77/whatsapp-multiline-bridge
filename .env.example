# Copy to .env and fill in. Never commit .env.
# Every value below is read from the environment at runtime — no secret is ever
# hardcoded in source, on the VPS or locally.

# ─────────────────────────────────────────────────────────────────────────────
# Local development
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# Which backend does local development talk to?
# ─────────────────────────────────────────────────────────────────────────────
# true   the deployed VM   → .env.backend.live
# false  this machine      → .env.backend.local
#
# scripts/load-env.mjs reads this file first, then applies the chosen one on top,
# and prints which it picked. Both the Operator Console and the bridge go through it, so
# they cannot end up pointed at different gateways.
#
# Only ADDRESSES belong in those two files. Credentials, the database and Chatwoot
# are identical in both modes and stay here, so there is exactly one copy of every
# secret. Two full .env files drift within a week, and the half that drifts is
# always the one holding a secret.
#
# Both files are gitignored — create them by hand:
#
#   .env.backend.live
#     EVOLUTION_BASE_URL=https://gateway.<your-vm-ip>.sslip.io
#     BRIDGE_PUBLIC_URL=https://bridge.<your-vm-ip>.sslip.io
#
#   .env.backend.local
#     EVOLUTION_BASE_URL=http://localhost:8080
#     BRIDGE_PUBLIC_URL=http://localhost:3001
#
# Override for a single command without editing anything:
#   USE_LIVE_BACKEND=false pnpm --filter @multiline/panel dev
#
# ⚠ In live mode the panel acts on real WhatsApp numbers, and the bridge must not
# be started locally — it would repoint the live webhooks at your machine. It
# detects that combination and refuses.
USE_LIVE_BACKEND=true

# Local Postgres stands in for the hosted Supabase project in development.
# Created by `pnpm db:setup`.
LOCAL_PG_PASSWORD=wa_local_dev

# ─────────────────────────────────────────────────────────────────────────────
# Supabase project for this system
# ─────────────────────────────────────────────────────────────────────────────
#   *_DATABASE_URL  → port 6543, transaction mode, ?pgbouncer=true&connection_limit=10
# Getting the transaction-mode flags wrong produces intermittent
# "prepared statement already exists" errors under load. See docs/01-evolution.md.
#
# Evolution also needs a session-mode URL on 5432 for its Prisma migrations, but
# that one is DATABASE_CONNECTION_URI in the gateway's own env file, not here.
# Point it at the pooler too: the direct host (db.<ref>.supabase.co) resolves to
# IPv6 only and is unreachable from networks without v6 transit.
#
# A Supabase project is a single database, so the two services are two schemas
# inside `postgres` rather than two databases: evolution and bridge.
# The pooler user is postgres.<project-ref>; the host region is the project's own.
#
# connection_limit is 10, not 1. connection_limit=1 is Prisma's serverless
# guidance; these are long-running servers, and 1 serialises every query through
# a single connection. Measured: ~5 concurrent requests was the ceiling, past
# which Prisma returned "Timed out fetching a new connection from the connection
# pool" — a client-side pool limit, not a pooler-side error.
EVOLUTION_DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?schema=evolution&pgbouncer=true&connection_limit=10"
# No ?schema= here — that is a Prisma parameter, and the bridge uses node-postgres,
# which ignores it. Its queries are schema-qualified (bridge.message_map) instead.
BRIDGE_DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# ─────────────────────────────────────────────────────────────────────────────
# Evolution API (WhatsApp gateway)
# ─────────────────────────────────────────────────────────────────────────────
# Full Evolution env lives in infra/local/evolution.env — the names there are
# pinned against the vendored source, not guessed. These are the ones our own
# services need in order to talk to it.
# EVOLUTION_BASE_URL is not here: it is an address, so it lives in the
# .env.backend.* file that USE_LIVE_BACKEND selects. The key is the same for both.
EVOLUTION_API_KEY=
# Required. Sent by Evolution as the x-bridge-secret header on every webhook, and
# checked by the bridge before a single message is believed. Without it the inbound
# endpoint would take anyone's word that a customer had written in.
# The bridge registers this with Evolution itself, so it only has to be set here.
# Generate:  openssl rand -hex 32
EVOLUTION_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Chatwoot Cloud (Startups plan) — system of record for conversations
# ─────────────────────────────────────────────────────────────────────────────
# SEED ONLY, since 2026-09-02. The live values are in the bridge.chatwoot_settings
# table, edited on the Operator Console's Settings screen — no restart, no redeploy.
# These variables exist for one purpose: on its first boot against an empty table,
# the bridge copies them in. After that they are inert and safe to delete. A fresh
# environment can leave them empty and enter the values in the panel instead.
CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_ACCOUNT_ID=
# Agent-bot or admin access token, used by the bridge to create contacts,
# conversations and messages.
CHATWOOT_API_TOKEN=
# Shared secret required on inbound Chatwoot webhooks so the endpoint cannot
# be driven by anyone who finds the URL.
CHATWOOT_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Encryption at rest for stored secrets
# ─────────────────────────────────────────────────────────────────────────────
# The Chatwoot API token and webhook secret live in bridge.chatwoot_settings, and
# are encrypted there with this key. It protects a copy of the database leaving
# without the servers — a backup, a dump, a connection string lent out for an
# afternoon. The key is never written to the database.
#
# The SAME value must be set on the bridge and on the Operator Console. They are two
# readers of one row; a mismatch means the panel cannot read what the bridge wrote.
# Changing it makes every stored secret unreadable, so rotating it means re-entering
# them on the settings screen afterwards.
# Generate:  openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Bridge service (Evolution ↔ Chatwoot)
# ─────────────────────────────────────────────────────────────────────────────
BRIDGE_PORT=3001
# BRIDGE_PUBLIC_URL is not here either — the address webhooks are delivered to
# differs per backend, so it lives in the .env.backend.* files above.
# Default country code used when normalising a WhatsApp number to E.164 and the
# number arrives without one.
DEFAULT_COUNTRY_CODE=
# Largest file the bridge will carry from WhatsApp into Chatwoot, in megabytes.
#
# This is a memory ceiling, not a time one. Evolution hands a file over as base64
# inside a JSON body, so one file in flight occupies roughly four times its own
# size in the bridge. On the 8GB VM that serves every line at once, this is what
# stops a few large files arriving together from taking the bridge down for
# everybody. Raising it is safe in proportion to that: 64MB is about 250MB per
# file in flight.
#
# Chatwoot is not the limiting side. Tested against the live account on
# 2026-09-11: 10, 25, 40, 50, 64, 80 and 100MB attachments were all accepted and
# stored whole, so nothing was refused up to 100MB. Raising this is a question
# about the bridge's memory, not about Chatwoot.
#
# Nothing is dropped when a file is over it: the agent gets a line of text saying
# what arrived and how big it was.
MAX_INBOUND_MEDIA_MB=64
# Which WhatsApp line feeds which Chatwoot inbox is not configured here. It lives
# in bridge.lines in the dedicated Supabase project, so the bridge and the
# Operator Console — separate deployments on separate machines — read the same rows.

# Logging. All three are optional and unset is the right answer in development:
# readable coloured lines at info level, which is what `docker compose logs`
# is for. Each one only has to be set to change that.
#
#   LOG_LEVEL=debug    adds the per-message tracing — every media conversion,
#                      every claim on a message, every webhook answered.
#                      Unset means info. (fatal|error|warn|info|debug|trace)
#   LOG_FORMAT=json    one JSON object per line instead of the pretty printer.
#                      Set this anywhere logs are collected and searched rather
#                      than read by eye. Any other value leaves it readable.
#   LOG_COLOR=false    drops the terminal colours. Worth setting wherever the
#                      output is captured to a file, which otherwise ends up
#                      holding the escape codes.
# LOG_LEVEL=
# LOG_FORMAT=
# LOG_COLOR=

# ─────────────────────────────────────────────────────────────────────────────
# Operator Console
# ─────────────────────────────────────────────────────────────────────────────
PANEL_PORT=3000

# Its own login: Supabase Auth, email and password only.
# Same Supabase project as everything else, reached over its HTTP API rather than
# Postgres because verifying a password and issuing a session is an API operation.
#
# Both values are in the Supabase dashboard under Project Settings → API.
# There is no session secret to set: Supabase signs the session cookies.
SUPABASE_URL=https://<ref>.supabase.co
# Safe to publish by design — it grants nothing on its own, and this project
# exposes no tables over the API. The panel still keeps it server-side.
SUPABASE_ANON_KEY=

# Optional second gate, comma-separated. Empty means any confirmed Supabase user in
# the project may sign in, which is only safe while sign-ups are disabled in the
# Supabase dashboard — Authentication → Sign In / Providers → Allow new users to
# sign up, off. Set this once anything else starts using the project's auth.
PANEL_ALLOWED_EMAILS=

# Where the panel is reachable from outside, e.g. https://panel.example.com. Used
# to build the link in a password-reset email, and nothing else. Leave it empty in
# development: the panel falls back to the address the request arrived on, which is
# correct locally and on a Vercel preview. Set it in production so a reset email
# always points at the real panel and never at a preview hostname.
PANEL_PUBLIC_URL=

# Where the Funnel screen gets its figures when the URL does not say. Two values:
#
#   chatwoot  (default)  read Chatwoot live on every render
#   mirror               read bridge.conversations, our own copy of Chatwoot's
#                        conversations, kept current by the sync in lib/sync.ts
#
# Both paths produce the same numbers; the copy answers in milliseconds and keeps
# the screen working while Chatwoot is slow or away, at the cost of being as fresh
# as the last sync. Either source can still be picked per request with `?source=`,
# so this only sets the default — which is why it is flipped by a deploy rather
# than by editing code. Leave it unset until the copy has filled at least once.
FUNNEL_SOURCE=

# ─────────────────────────────────────────────────────────────────────────────
# Monitoring and alerting
# ─────────────────────────────────────────────────────────────────────────────
# How long a line may stay disconnected before the alert email goes out. A
# gateway emits close/connecting/open bursts during an ordinary reconnect, so
# this grace period is what turns one real outage into one email.
LINE_DISCONNECT_ALERT_SECONDS=180

# Alert email goes out through Resend (https://resend.com), not SMTP. There used
# to be an SMTP form on the Settings screen writing bridge.smtp_settings; it is
# gone. One API key covers every environment, and unlike a host/port/username/
# password form it cannot be left half-filled.
#
# BOTH services read these and both need them set: the bridge sends the automatic
# disconnect alerts, the panel sends the "Send test email" from the Notifications
# settings. On Vercel, set them in the project's environment variables too — the
# panel deployed there does not read this file.
#
# The key is in the Resend dashboard under API Keys.
RESEND_API_KEY=
# The From line. Resend only accepts an address on a domain verified in its
# dashboard (Domains → Add domain, then the DNS records it gives you). Left as
# the default below, sending still works but Resend delivers only to the Resend
# account's own email address — fine for a first test, not for real alerts.
ALERT_FROM_EMAIL=onboarding@resend.dev

# Local screens only: feed the Funnel's Online-time chart made-up readings for
# every agent, for looking at the chart before the real record has filled. Read
# only by a development build — a production build ignores it whatever it says.
FUNNEL_MOCK_ONLINE=

# ─────────────────────────────────────────────────────────────────────────────
# Deployment
# ─────────────────────────────────────────────────────────────────────────────
# The GitHub user or organisation the bridge image is published under,
# lower-cased. Read by infra/gcp/compose.yaml to build the image reference:
# ghcr.io/$GHCR_OWNER/multiline-bridge
GHCR_OWNER=

# ─────────────────────────────────────────────────────────────────────────────
# Business timezone — how a "day" is decided
# ─────────────────────────────────────────────────────────────────────────────
# A team and its customers live in one place, so "Today" on the Funnel means
# their today, not the server's. Both services need this and both default to UTC.
#
# It must be a FIXED-OFFSET zone: the arithmetic adds a single constant rather
# than consulting zone data, so a zone with daylight saving would be wrong for
# half the year. The panel's test suite asserts the offset against Node's own
# zone data, which is what catches a mismatched pair.
#
# The NEXT_PUBLIC_ copies are what the Operator Console reads — the value reaches
# client-side chart components, so Next has to inline it at build time. Set them
# on Vercel too; the deployed panel does not read this file.
NEXT_PUBLIC_BUSINESS_TIMEZONE=UTC
NEXT_PUBLIC_BUSINESS_UTC_OFFSET_HOURS=0
NEXT_PUBLIC_BUSINESS_TIMEZONE_LABEL=UTC
# The bridge's copy, for the time printed in alert emails.
BUSINESS_UTC_OFFSET_HOURS=0
BUSINESS_TIMEZONE_LABEL=UTC

# ─────────────────────────────────────────────────────────────────────────────
# Funnel
# ─────────────────────────────────────────────────────────────────────────────
# The earliest day the Funnel can tell the truth about, usually the day the
# Chatwoot account was created. Every range is clamped to it and the screen
# says so, rather than quietly reporting a 90-day figure built from 30 days of
# data. Empty means no floor.
NEXT_PUBLIC_DATA_STARTS=
